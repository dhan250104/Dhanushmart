# Copy these values into your hosting provider's Environment/Variables settings.
# Do not commit real credentials to GitHub.
DB_URL=jdbc:mysql://YOUR_MYSQL_HOST:3306/YOUR_DATABASE_NAME
DB_USERNAME=YOUR_MYSQL_USERNAME
DB_PASSWORD=YOUR_MYSQL_PASSWORD
# Optional: only required for AI image search feature
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
